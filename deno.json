{
  "imports": {
    "@std/assert": "https://deno.land/std@0.224.0/assert/mod.ts"
  },
  "tasks": {
    "run": "deno run --allow-env main.ts",
    "build": "deno compile --allow-env --output log main.ts",
    "test": "deno test --allow-env --allow-read --allow-run --coverage"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
