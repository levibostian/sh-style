{
  "name": "@levibostian/sh-style",
  "exports": "./main.ts",
  "publish": {
    "include": [
      "README.md",
      "LICENSE",
      "src/**/*.ts",
      "*.ts"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.18"
  },
  "tasks": {
    "run": "deno run --allow-env main.ts",
    "build": "deno compile --allow-env --output log main.ts",
    "test": "deno test --allow-env --allow-read --allow-run --allow-write --coverage=reports/coverage/ --junit-path reports/junit.xml"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
