{
  "name": "@levibostian/sh-style",
  "exports": "./mod.ts",
  "publish": {
    "include": ["README.md", "LICENSE", "mod.ts", "bin/*"]
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
