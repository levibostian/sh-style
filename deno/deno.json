{
  "name": "@levibostian/sh-style",
  "license": "MIT",
  "exports": "./mod.ts",  
  "publish": {
    "include": ["mod.ts", "bin/**"],
    "exclude": ["!bin"]
  },
  "imports": {
    "@cross/runtime": "jsr:@cross/runtime@^1",
    "@cross/env": "jsr:@cross/env@^1"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
