{
  "name": "@levibostian/sh-style",
  "license": "MIT",
  "exports": "./mod.ts",
  "publish": {
    "include": ["mod.ts", "bin/**", "README.md"],
    "exclude": ["!bin"]
  },
  "imports": {
    "@cross/env": "jsr:@cross/env@^1.0.3"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  }
}
